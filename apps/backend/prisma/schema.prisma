generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

enum TaskStatus {
  /// 主任务：仅需求，尚未生成子任务
  CREATED
  /// 主任务：已生成子任务，等待人审计划（与 WAITING_PLAN_APPROVAL 二选一使用时可省略）
  PLAN_GENERATED
  WAITING_PLAN_APPROVAL
  PLAN_APPROVED
  PENDING
  WAITING_APPROVAL
  RUNNING
  /// 子任务：Worker 步骤超时等可续跑暂停（result 含 remainingSteps）
  WORKER_PAUSED
  COMPLETED
  FAILED
}

model Task {
  id         String     @id @default(uuid())
  parentId   String?
  parent     Task?      @relation("TaskTree", fields: [parentId], references: [id], onDelete: Cascade)
  children   Task[]     @relation("TaskTree")
  name       String
  status     TaskStatus @default(CREATED)
  role       String?
  /// 同级排序，对应库列名 order（Prisma 字段名用 sortOrder 避免与 orderBy 语义混淆）
  sortOrder  Int        @default(0) @map("order")
  parameters Json?
  result     Json?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
}
