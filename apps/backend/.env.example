# 若出现 EADDRINUSE:3000，可改为 3001 或其它空闲端口
PORT=3000

# 路径相对「prisma/schema.prisma」所在目录，故用 ./dev.db → 生成 apps/backend/prisma/dev.db
# 若写成 ./prisma/dev.db 会变成 prisma/prisma/dev.db，易误以为「库没建好」
DATABASE_URL="file:./dev.db"

# 可选：Worker 文件工具沙箱的根目录（默认：从 apps/backend 起向上两级 =  monorepo 根）
# WORKSPACE_ROOT=E:/githubProjects/DevAgentOS
REDIS_URL="redis://127.0.0.1:6379"

# 通义千问 DashScope（OpenAI 兼容 Chat Completions）
# 在阿里云控制台创建 API Key：https://dashscope.console.aliyun.com/
# 未配置时任务拆分自动走规则 fallback，不阻塞创建任务
# DASHSCOPE_API_KEY=
# LLM_MODEL=qwen-turbo
# LLM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1/chat/completions
